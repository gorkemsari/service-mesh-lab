# service-mesh-lab ayarları
#
# Tek ayar kaynağı: ortam (env/), mesh'ler, test uygulaması, testler ve rapor buradan okur.
# Tüm sürümler sabittir; her test koşusu kullandığı sürümleri results/<koşu>/meta.json'a yazar.
# Makineye özel değişiklikler için config.local.env (git'e girmez) kullanın; aynı adlı değişkeni ezer.

# =========================================================================== Test ortamı (env/)
# kind cluster'ları: <CLUSTER_PREFIX><rol>  ->  sml-dmz-a, sml-dmz-b, sml-app, sml-data, sml-mgmt
CLUSTER_PREFIX=sml-
KIND_NODE_IMAGE=kindest/node:v1.37.0
INGRESS_NGINX_CHART_VERSION=4.15.1
HAPROXY_IMAGE=haproxy:3.0-alpine
EDGE_LB=sml-edge-lb                # edge load balancer container'ı

# Host'ta yalnızca 127.0.0.1'e açılan portlar. Makinede doluysa config.local.env'de değiştirin.
HOST_HTTP_PORT=80                  # edge LB: "internet" girişi (http)
HOST_HTTPS_PORT=443                # edge LB: "internet" girişi (https://shop.localtest.me)
HOST_LB_STATS_PORT=9404            # edge LB istatistik sayfası
HOST_MGMT_HTTP_PORT=9080           # sml-mgmt ingress (http)
HOST_MGMT_HTTPS_PORT=9443          # sml-mgmt ingress: Grafana, Prometheus

# Zone network'leri (docker bridge). Docker farklı bridge'ler arası trafiği engellediği için
# bunlar firewall'lı network segmentleri gibi davranır (bkz. docs/mimari.md).
NET_EDGE=sml-edge
NET_DMZ=sml-dmz
NET_APP=sml-app
NET_DATA=sml-data
NET_MGMT=sml-mgmt
NET_EDGE_SUBNET=172.29.5.0/24
NET_DMZ_SUBNET=172.29.10.0/24
NET_APP_SUBNET=172.29.20.0/24
NET_DATA_SUBNET=172.29.30.0/24
NET_MGMT_SUBNET=172.29.40.0/24

# Cluster dışındaki egress hedefleri (S07). NET_APP_SUBNET içinde, /31 sınırında ardışık iki adres.
EGRESS_ALLOWED_IP=172.29.20.250
EGRESS_DENIED_IP=172.29.20.251

# Node CPU sabitleme (docker cpuset). Varsayılanlar 12 çekirdekli host içindir.
CPUSET_APP=0-3                     # sml-app-worker  : test servis zinciri
CPUSET_LOADGEN=4-6                 # sml-app-worker2 : k6 yük üretici
CPUSET_CONTROL=7-8                 # sml-app-control-plane : ingress, mesh kontrol düzlemi, gözlem ajanı
CPUSET_OTHER=9-11                  # diğer cluster'lar, edge LB, egress hedefleri

# =========================================================================== Mesh'ler
ISTIO_VERSION=1.31.4
ISTIO_PREV_VERSION=1.30.8          # R05 (kesintisiz güncelleme) başlangıç sürümü
ISTIO_HUB=docker.io/istio
LINKERD_VERSION=edge-26.11.2
LINKERD_PREV_VERSION=edge-26.10.2  # R05 başlangıç sürümü
GATEWAY_API_VERSION=v1.6.1         # Istio 1.31 (v1.6.0 ile derlenmiş) ve Linkerd edge-26.11 (v1.6.1 ister) ortak

# =========================================================================== Gözlem (sml-mgmt)
PROMETHEUS_CHART_VERSION=29.47.2
GRAFANA_CHART_VERSION=10.5.15
TEMPO_CHART_VERSION=1.24.4

# =========================================================================== Test uygulaması (apps/)
# chainsvc dil uygulamaları: apps/chainsvc/<dil>/ (her biri apps/chainsvc/README.md sözleşmesine uyar).
# İmaj: <CHAINSVC_IMAGE_REPO>-<dil>:<CHAINSVC_VERSION>  ->  smlab/chainsvc-go:1.0.0
APP_LANGS=go,dotnet                # desteklenen diller (suite varsayılanı, rapor sırası)
APP_LANG=go                        # 'smlab app use' ile değiştirilmemişse kullanılan dil
CHAINSVC_IMAGE_REPO=smlab/chainsvc
CHAINSVC_VERSION=1.0.0

SHOP_NS=shop                       # test servis zinciri
LOADGEN_NS=loadgen                 # k6
OUTSIDE_NS=outside                 # mesh dışı istemci (atlatma denemeleri)

# Her servisin yapay işlem süresi: mesh ek maliyeti görünsün diye kısa tutulur.
SVC_TIMING_P50=1ms
SVC_TIMING_P90=2ms
SVC_TIMING_P99=5ms
SVC_REPLICAS=2
# Uygulama seviyesinde Zipkin trace'i. Varsayılan kapalı (yük testlerinde ölçümü bozar); O01 geçici açar.
SVC_TRACING_ZIPKIN=
# Zincir her (yeniden) dağıtıldıktan sonra ölçümden önce uygulanan ısınma yükü (sn; 0 = kapalı). Tüm dillerde aynı:
# JIT derleyicili çalışma zamanlarının (.NET) soğuk başlangıcı ve boş bağlantı havuzları ölçüme karışmasın.
APP_WARMUP_S=60

K6_IMAGE=grafana/k6:2.4.0
NETSHOOT_IMAGE=nicolaka/netshoot:v0.14

# =========================================================================== Rapor: prod projeksiyonu varsayımları
PROD_SERVICES=3000
PROD_REPLICAS_PER_SERVICE=3        # ortalama replika
PROD_PODS_PER_NODE=30              # node başına ortalama pod
PROD_NODE_VCPU=16                  # worker node boyutu
PROD_NODE_MEM_GB=64
PROD_TOTAL_RPS=30000               # tüm servislerin toplam iç (east-west) istek hızı
PROD_SERVICES_PER_WAYPOINT=10      # ambient L7: waypoint başına servis (namespace başına bir waypoint)
